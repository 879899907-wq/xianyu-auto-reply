# =============================================
# 闲鱼自动回复系统 - 生产环境配置模板
# 复制此文件为 .env 并按需修改
# =============================================

# ----- Web 服务端口 -----
WEB_PORT=8080

# ----- 时区 -----
TZ=Asia/Shanghai

# ----- 数据库 -----
DB_PATH=/app/data/xianyu_data.db

# ----- 日志级别 (DEBUG / INFO / WARNING / ERROR) -----
LOG_LEVEL=INFO
DEBUG=false
RELOAD=false

# ----- SQL 日志 -----
SQL_LOG_ENABLED=true
SQL_LOG_LEVEL=INFO

# ----- 管理员账号（⚠️ 生产环境必须修改，禁止使用默认值！）-----
ADMIN_USERNAME=admin
# 请设置强密码（建议 16 位以上，含大小写字母、数字、特殊字符）
ADMIN_PASSWORD=CHANGEME_SET_A_STRONG_PASSWORD

# ----- JWT 安全密钥（⚠️ 生产环境必须修改为随机长字符串！）-----
# 生成命令：openssl rand -hex 32
JWT_SECRET_KEY=CHANGEME_RUN_openssl_rand_hex_32

# ----- 会话 -----
SESSION_TIMEOUT=3600
TOKEN_EXPIRE_TIME=86400

# ----- 多用户系统 -----
MULTIUSER_ENABLED=true
USER_REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_ENABLED=true
CAPTCHA_ENABLED=true

# ----- 自动回复 / 自动发货 -----
AUTO_REPLY_ENABLED=true
AUTO_DELIVERY_ENABLED=true
AUTO_DELIVERY_TIMEOUT=30
API_CARD_TIMEOUT=10
BATCH_DATA_LOCK_TIMEOUT=5

# ----- AI 回复（需配置 API Key 后启用）-----
AI_REPLY_ENABLED=false
DEFAULT_AI_MODEL=qwen-plus
DEFAULT_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_REQUEST_TIMEOUT=30
AI_MAX_TOKENS=100

# ----- WebSocket -----
WEBSOCKET_URL=wss://wss-goofish.dingtalk.com/
HEARTBEAT_INTERVAL=15
HEARTBEAT_TIMEOUT=5
TOKEN_REFRESH_INTERVAL=3600
TOKEN_RETRY_INTERVAL=300
MESSAGE_EXPIRE_TIME=300000

# ----- Docker 资源限制 -----
MEMORY_LIMIT=2048
CPU_LIMIT=2.0
MEMORY_RESERVATION=512
CPU_RESERVATION=0.5

# ----- Python -----
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
